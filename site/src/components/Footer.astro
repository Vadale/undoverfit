---
import { SITE } from "~/lib/site";

const year = new Date().getFullYear();
const range =
  year > SITE.startYear ? `${SITE.startYear}–${year}` : `${SITE.startYear}`;
---

<footer class="mx-auto w-full max-w-prose px-5 py-16 text-sm text-ink-3">
  <div class="flex items-center justify-between">
    <span>© {range} {SITE.name}</span>
    <a href="/rss.xml" class="no-underline hover:underline">RSS</a>
  </div>
  <nav aria-label="Social profiles" class="mt-4 flex flex-wrap gap-x-5 gap-y-3">
    <a href="https://www.linkedin.com/in/alessandro-vadal%C3%A0-851516180/" class="no-underline hover:underline">LinkedIn</a>
    <a href="https://x.com/undoverfit" class="no-underline hover:underline">X</a>
    <a href="https://bsky.app/profile/undoverfit.bsky.social" class="no-underline hover:underline">Bluesky</a>
    <a href="https://www.threads.com/@alevad_93" class="no-underline hover:underline">Threads</a>
    <a href="https://github.com/Vadale" class="no-underline hover:underline">GitHub</a>
  </nav>
</footer>
